# learning-system cron entries (managed by install_cron.sh — do not edit between markers)
#
# All commands source ~/.claude/bin/learning-system/.env before running so that
# ANTHROPIC_API_KEY (and any other config) is available — cron starts with a
# nearly-empty environment by default. Create .env from .env.example.

# Daily 02:00: scan opted-in projects, extract new/changed transcripts
0 2 * * * . /Users/__USER__/.claude/bin/learning-system/.env 2>/dev/null; /Users/__USER__/.claude/bin/learning-system/.venv/bin/python /Users/__USER__/.claude/bin/learning-system/extractor.py --scan-all >> /Users/__USER__/.claude/bin/learning-system/error.log 2>&1

# Saturday 02:30: weekly bird-eye report for ai-inference-track
30 2 * * 6 . /Users/__USER__/.claude/bin/learning-system/.env 2>/dev/null; /Users/__USER__/.claude/bin/learning-system/.venv/bin/python /Users/__USER__/.claude/bin/learning-system/aggregator.py --project-dir /Users/__USER__/Documents/code/ai-inference-track >> /Users/__USER__/.claude/bin/learning-system/error.log 2>&1

# 1st of month 02:45: drift report for last completed month
45 2 1 * * . /Users/__USER__/.claude/bin/learning-system/.env 2>/dev/null; /Users/__USER__/.claude/bin/learning-system/.venv/bin/python /Users/__USER__/.claude/bin/learning-system/drift_monitor.py --project-dir /Users/__USER__/Documents/code/ai-inference-track >> /Users/__USER__/.claude/bin/learning-system/error.log 2>&1
# end learning-system cron entries
