# Copy this file to .env and fill in your real key. The cron jobs source this
# file so ANTHROPIC_API_KEY is available — cron does NOT see your shell env.
#
# Get a key at https://console.anthropic.com/  (requires billing for API access).
# Stage 1 first-run cost estimate is ~$15 in Opus input tokens for ~5 backlogged
# transcripts (~1M input tokens). Run `./dry-run.sh` first to preview.

export ANTHROPIC_API_KEY="sk-ant-..."
